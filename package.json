{
  "name": "blyg-publisher",
  "version": "0.2.0",
  "description": "Write in Obsidian, publish to your Blygger blyg (existing reference-server blyg, or a static one).",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && vitest run && node esbuild.config.mjs production",
    "install-plugin": "npm run build && node scripts/dev-install.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brndnpink/blyg-publisher"
  }
}
