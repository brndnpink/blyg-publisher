{
  "name": "blyg-publisher",
  "version": "0.0.1",
  "description": "Publish a Blygger blyg from one folder of an Obsidian vault to a static host.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && vitest run && node esbuild.config.mjs production",
    "install-plugin": "npm run build && node scripts/install.mjs",
    "test": "vitest run"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.1",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "markdown-it": "^14.3.2"
  }
}
